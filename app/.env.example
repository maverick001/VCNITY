# Copy to app/.env and fill in. Never commit app/.env.

# HuggingFace read token — needed only for speaker diarisation (pyannote).
# Accept the terms on huggingface.co/pyannote/speaker-diarization-3.1 and
# huggingface.co/pyannote/segmentation-3.0 first.
HF_TOKEN=

# Local model served by Ollama. Must have vision capability.
OLLAMA_MODEL=qwen3.5:4b

# Where the raw material lives. Default: <repo>/Data/raw
# VCNITY_DATA_DIR=

# Where the venv, embedded Postgres data, model cache and Reflex build go.
# Default: ~/.vcnity  (kept out of the Google Drive folder on purpose)
# VCNITY_HOME=

# Fewer than this many people behind a theme → identifiability flag (PRD A6)
VCNITY_SMALL_N=3

# Who receives a harm report (PRD A13). Left UNSET on purpose until the client names someone.
# VCNITY_SAFETY_CONTACT=

# Hosted providers are refused regardless; this flag only lets Level 1 *try* one.
VCNITY_ALLOW_HOSTED=0

VCNITY_API_PORT=8100
