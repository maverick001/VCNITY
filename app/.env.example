# Copy this file to app/.env and fill in your personal HF_Token. 

# HuggingFace read token — needed only for speaker diarisation (pyannote).
HF_TOKEN=

# Local text model, used by every stage except artefact reading (theme
# labels, evidence checks, identifiability, reports). 
OLLAMA_MODEL=qwen3.5:4b

# Local vision model, used only for stage 3 (reading photos of artefacts).  
OLLAMA_VISION_MODEL=qwen3-vl:4b

# VCNITY_VISION_MAX_TOKENS=3000


# Fewer than this many people behind a theme → identifiability flag (PRD A6)
VCNITY_SMALL_N=3

# Who receives a harm report (PRD A13). Left UNSET on purpose until the client names someone.
# VCNITY_SAFETY_CONTACT=

# Hosted providers are refused regardless; this flag only lets Level 1 *try* one.
VCNITY_ALLOW_HOSTED=0

VCNITY_API_PORT=8100
