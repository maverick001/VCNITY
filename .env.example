# Copy to app/.env and fill in. Never commit app/.env.

# HuggingFace read token — needed only for speaker diarisation (pyannote).
# Accept the terms on huggingface.co/pyannote/speaker-diarization-3.1 and
# huggingface.co/pyannote/segmentation-3.0 first.
HF_TOKEN=

# Local text model, used by every stage except artefact reading (theme
# labels, evidence checks, identifiability, reports). Ollama.
OLLAMA_MODEL=qwen3.5:4b

# Local vision model, used only for stage 3 (reading photos of artefacts). Ollama.
# Note: qwen3-vl:4b ignores Ollama's think=False and always runs a full
# reasoning pass first — stage 3's token budget (VCNITY_VISION_MAX_TOKENS) is
# sized generously to give it room to get through that before answering.
# The two models above are never loaded into Ollama at the same time — see
# vcnity/providers/ollama_local.py — so a 16GB, no-GPU machine is enough as
# long as pipeline stages still run one at a time, not in parallel.
OLLAMA_VISION_MODEL=qwen3-vl:4b
# VCNITY_VISION_MAX_TOKENS=3000

# Where the raw material lives. Default: <repo>/Data/raw
# VCNITY_DATA_DIR=

# Where the venv, embedded Postgres data, model cache and Reflex build go.
# Default: ~/.vcnity  (kept out of the Google Drive folder on purpose)
# VCNITY_HOME=

# Fewer than this many people behind a theme → identifiability flag (PRD A6)
VCNITY_SMALL_N=3

# Who receives a harm report (PRD A13). Left UNSET on purpose until the client names someone.
# VCNITY_SAFETY_CONTACT=

# Hosted providers are refused regardless; this flag only lets Level 1 *try* one.
VCNITY_ALLOW_HOSTED=0

VCNITY_API_PORT=8100
